@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fitboom_2.0</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Fitboom2._8.styles.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar-fitboom d-flex justify-content-between align-items-center px-4 py-3" style="background-color: #121212; color: white;">
        <!-- Logo -->
        <div class="logo">
            <span style="color: #ADFF2F; font-weight: bold; font-size: 24px;">FITBOOM</span>
        </div>

        <!-- Enlaces del menú -->
        <ul class="nav-links list-unstyled d-flex gap-4 m-0">
            <li><a href="#" class="text-white text-decoration-none">INICIO</a></li>
            <li><a href="#" class="text-white text-decoration-none">PROGRAMAS Y PAGOS</a></li>
            <li><a href="#" class="text-white text-decoration-none">NUESTRO EQUIPO</a></li>
        </ul>

        <!-- Perfil de usuario con menú desplegable en la esquina superior derecha -->
        <div class="dropdown">
            <a href="#" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle gap-2" id="dropdownUser1" data-bs-toggle="dropdown" aria-expanded="false">
                <div class="text-end d-none d-sm-block">
                    <!-- Nombre dinámico desde la sesión -->
                    <span class="d-block fw-bold" style="font-size: 14px;">
                        (HttpContextAccessor.HttpContext?.Session.GetString("NombreUsuario")
                    </span>
                    <!-- Rol dinámico desde la sesión -->
                    <span class="d-block" style="font-size: 11px; color: #ADFF2F;">
                        @(HttpContextAccessor.HttpContext?.Session.GetString("RolUsuario") ?? "Administrador")
                    </span>
                </div>
                <img src="~/images/imagen predeterminada.jpg" alt="Foto de perfil" class="rounded-circle border" width="40" height="40" style="object-fit: cover; border-color: #ADFF2F !important;" />
            </a>
            <ul class="dropdown-menu dropdown-menu-dark text-small shadow" aria-labelledby="dropdownUser1" style="background-color: #1a1a1a; border: 1px solid #333;">
                <li><a class="dropdown-item" href="#">Ver Perfil</a></li>
                <li><a class="dropdown-item" href="#">Configuración</a></li>
                <li><hr class="dropdown-divider" style="border-color: #333;"></li>
                <li><a class="dropdown-item text-danger" href="#">Cerrar Sesión</a></li>
            </ul>
        </div>
    </nav>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
