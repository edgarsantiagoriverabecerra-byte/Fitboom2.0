@model TuProyecto.Models.PerfilViewModel

@{
    ViewData["Title"] = "Mi Perfil";
}

<div class="container py-4" style="color: #ffffff;">
    <h2 class="mb-4" style="color: #ADFF2F; font-weight: bold;">Mi Perfil</h2>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert" style="background-color: #1e3a1e; border-color: #2e5a2e; color: #ADFF2F;">
            @TempData["MensajeExito"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorPerfil"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorPerfil"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form asp-controller="Account" asp-action="Perfil" method="post" enctype="multipart/form-data">
        <div class="row g-4">
            <!-- Columna Izquierda: Foto de Perfil -->
            <div class="col-md-4">
                <div class="card p-3 text-center" style="background-color: #1f242d; border: 1px solid #2e3542; border-radius: 8px;">
                    <div class="mb-3 d-flex justify-content-center">
                        <img id="previewFoto" src="@(string.IsNullOrEmpty(Model.FotoRuta) ? "/images/imagen predeterminada.jpg" : Model.FotoRuta)"
                             alt="Foto de Perfil"
                             class="rounded-circle border"
                             style="width: 160px; height: 160px; object-fit: cover; border-color: #ADFF2F !important;" />
                    </div>
                    <label class="form-label text-muted mb-2">Cambiar Foto de Perfil</label>
                    <input type="file" class="form-control form-control-sm bg-secondary text-white border-0" asp-for="FotoArchivo" accept="image/*" onchange="mostrarVistaPrevia(this)" />
                </div>
            </div>

            <!-- Columna Derecha: Información de Perfil -->
            <div class="col-md-8">
                <div class="card p-4" style="background-color: #1f242d; border: 1px solid #2e3542; border-radius: 8px;">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Nombre Completo</label>
                        <input type="text" class="form-control bg-secondary text-white border-0 py-2" asp-for="Nombre" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted">Correo Electrónico</label>
                        <input type="email" class="form-control bg-secondary text-white border-0 py-2" asp-for="Correo" readonly style="opacity: 0.7; cursor: not-allowed;" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted">Rol Asignado</label>
                        <input type="text" class="form-control bg-secondary text-white border-0 py-2" asp-for="Rol" readonly style="opacity: 0.7; cursor: not-allowed;" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Restricciones Alimenticias</label>
                        <textarea class="form-control bg-secondary text-white border-0" asp-for="RestriccionesAlimenticias" rows="3" placeholder="Ej. Intolerante a la lactosa, vegetariano, alergia a frutos secos..."></textarea>
                    </div>

                    <div class="mt-2">
                        <button type="submit" class="btn font-weight-bold px-4 py-2" style="background-color: #ADFF2F; color: #000; font-weight: bold;">
                            Guardar Cambios
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function mostrarVistaPrevia(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById('previewFoto').src = e.target.result;
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}