                    <p class="text-brand fw-bold mb-1 text-uppercase">// Contacto</p>
                    <h2 class="display-4 fw-bold text-uppercase brand-title mb-4">Hablemos de tus metas</h2>
                    <p class="mb-4">Agenda tu prueba gratuita o indícanos tus objetivos para asignarte el entrenador adecuado.</p>
                    <div class="small text-secondary mb-2"><strong class="text-white">Ubicación:</strong> Carrera 18 # 42-27, Barrio El Prado</div>
                    <div class="small text-secondary mb-2"><strong class="text-white">Horario:</strong> Lun - Vie: 5:00 am - 11:00 pm | Sáb - Dom: 7:00 am - 9:00 pm</div>
                    <div class="small text-secondary"><strong class="text-white">Contacto:</strong> +57 314 255 6987 | contacto@fitboom.co</div>
                </div>
                <div class="col-lg-6">
                    <form class="bg-black p-4 border border-secondary rounded">
                        <div class="mb-3">
                            <label class="form-label small text-uppercase text-secondary">Nombre Completo</label>
                            <input type="text" class="form-control bg-dark text-white border-secondary" placeholder="Tu nombre" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small text-uppercase text-secondary">Correo Electrónico</label>
                            <input type="email" class="form-control bg-dark text-white border-secondary" placeholder="tu@email.com" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small text-uppercase text-secondary">Teléfono</label>
                            <input type="tel" class="form-control bg-dark text-white border-secondary" placeholder="+57 300 000 0000" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small text-uppercase text-secondary">Programa de Interés</label>
                            <select class="form-select bg-dark text-white border-secondary">
                                <option selected>Entrenamiento Personal 1 a 1</option>
                                <option>Fuerza y Acondicionamiento</option>
                                <option>Plan Nutricional Clínico / Deportivo</option>
                                <option>HIIT & Funcional</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-brand w-100 fw-bold text-uppercase py-2">Enviar Mensaje</button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- ================= FITBOT UI ================= -->
    <button id="fitbotToggleBtn" class="fitbot-floating-btn fitbot-pulse" aria-label="Abrir FitBot">
        🤖
    </button>

    <div id="fitbotWindow" class="fitbot-window">
        <div class="fitbot-header">
            <div class="d-flex align-items-center gap-2">
                <span class="fs-4">🤖</span>
                <div>
                    <h6 class="mb-0 text-white fw-bold brand-title" style="letter-spacing: 0.5px;">FITBOT</h6>
                    <small class="text-secondary d-flex align-items-center gap-1" style="font-size: 0.72rem;">
                        <span class="fitbot-status-dot"></span> En línea
                    </small>
                </div>
            </div>
            <button id="fitbotCloseBtn" class="btn btn-sm btn-link text-secondary text-decoration-none p-0 fs-5" aria-label="Cerrar chat">&times;</button>
        </div>

        <div id="fitbotBody" class="fitbot-body">
            <div class="fitbot-msg bot">
                ¡Hola! Soy <strong>FitBot</strong> ⚡. Estoy aquí para guiarte en tu entrenamiento personalizado y nutrición adaptativa. ¿Qué deseas consultar?
            </div>

            <div class="fitbot-options" id="fitbotOptions">
                <button class="fitbot-opt-btn" onclick="handleFitbotQuestion('Planes de entrenamiento', '#programas', 'Descubre nuestros 4 programas adaptables según tus lesiones o nivel.')">
                    <span>🏋️ Planes de entrenamiento</span>
                    <i class="bi bi-chevron-right"></i>
                </button>

                <button class="fitbot-opt-btn" onclick="handleFitbotQuestion('Planes nutricionales', '#nutricion', 'Nuestros planes calculan macros y sustituyen alimentos si tienes alergias o intolerancias.')">
                    <span>🥗 Planes nutricionales</span>
                    <i class="bi bi-chevron-right"></i>
                </button>

                <button class="fitbot-opt-btn" onclick="handleFitbotQuestion('Precios de membresías', '#membresias', 'Te llevo a ver nuestros planes Básico, Pro y Élite con todo incluido.')">
                    <span>💳 Precios de membresías</span>
                    <i class="bi bi-chevron-right"></i>
                </button>

                <button class="fitbot-opt-btn" onclick="handleFitbotQuestion('Conocer entrenadores', '#entrenadores', 'Conoce a nuestros especialistas certificados en fuerza, nutrición y funcional.')">
                    <span>👥 Conocer entrenadores</span>
                    <i class="bi bi-chevron-right"></i>
                </button>

                <button class="fitbot-opt-btn" onclick="handleFitbotQuestion('Contacto directo', '#contacto', 'Aquí tienes nuestro formulario, teléfono y correo para atención inmediata.')">
                    <span>📩 Contacto</span>
                    <i class="bi bi-chevron-right"></i>
                </button>

                <button class="fitbot-opt-btn" onclick="handleFitbotQuestion('Ubicación del gimnasio', '#contacto', 'Estamos en la Carrera 18 # 42-27, Barrio El Prado. ¡Te esperamos!')">
                    <span>📍 Ubicación</span>
                    <i class="bi bi-chevron-right"></i>
                </button>

                <button class="fitbot-opt-btn" onclick="handleFitbotQuestion('Prueba gratuita', '#contacto', '¡Tienes 1 semana gratis sin compromiso! Completa el formulario para activarla.')">
                    <span>🔥 Prueba gratuita</span>
                    <i class="bi bi-chevron-right"></i>
                </button>

                <button class="fitbot-opt-btn" onclick="handleFitbotQuestion('Testimonios de miembros', '#testimonios', 'Conoce los casos reales de personas que transformaron su rendimiento con nosotros.')">
                    <span>⭐ Testimonios</span>
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>
        </div>

        <div class="fitbot-footer">
            <small class="text-secondary" style="font-size: 0.72rem;">FitBoom AI • Personalización & Nutrición</small>
        </div>
    </div>

    <!-- ================= MODAL REGISTRO & DIAGNÓSTICO ================= -->
    <div class="modal fade" id="modalOnboarding" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 460px;">
            <div class="modal-content fitboom-auth-modal p-4 p-md-5 position-relative">

                <button type="button" class="btn-close-clean" data-bs-dismiss="modal" aria-label="Cerrar">&times;</button>

                <div class="mb-4">
                    <span class="auth-pretitle text-brand fw-bold d-block mb-1" id="stepSub">// CREAR CUENTA</span>
                    <div class="d-flex justify-content-between align-items-end">
                        <h2 class="auth-title brand-title text-white text-uppercase mb-0" id="wizardTitle">REGISTRO</h2>
                        <span class="auth-step-badge" id="stepIndicator">PASO 1 / 2</span>
                    </div>
                </div>

                <form id="registerWizardForm" novalidate>

                    <!-- PASO 1: DATOS DE CUENTA -->
                    <div id="step1Container">
                        <div class="mb-3">
                            <label class="auth-label">NOMBRE COMPLETO</label>
                            <input type="text" id="regName" class="form-control auth-input" placeholder="Tu nombre" required>
                        </div>

                        <div class="mb-3">
                            <label class="auth-label">CORREO ELECTRÓNICO</label>
                            <input type="email" id="regEmail" class="form-control auth-input" placeholder="tu@email.com" required>
                        </div>

                        <div class="mb-3">
                            <label class="auth-label">TELÉFONO</label>
                            <input type="tel" id="regPhone" class="form-control auth-input" placeholder="+57 300 000 0000" required>
                        </div>

                        <div class="mb-3">
                            <label class="auth-label">CONTRASEÑA</label>
                            <input type="password" id="regPass" class="form-control auth-input" placeholder="Mínimo 6 caracteres" required>
                        </div>

                        <div class="mb-4">
                            <label class="auth-label">CONFIRMAR CONTRASEÑA</label>
                            <input type="password" id="regPassConf" class="form-control auth-input" placeholder="Repite tu contraseña" required>
                        </div>

                        <div id="step1Error" class="alert alert-danger py-2 small mb-3 d-none text-uppercase" style="font-size: 0.75rem;"></div>

                        <button type="button" id="btnGoToStep2" class="btn btn-brand w-100 fw-bold text-uppercase py-2 mb-3">
                            CONTINUAR AL DIAGNÓSTICO &rarr;
                        </button>

                        <div class="text-center">
                            <small class="text-secondary" style="font-size: 0.82rem;">
                                ¿Ya tienes cuenta?
                                <a href="#" class="text-brand text-decoration-none fw-semibold" data-bs-toggle="modal" data-bs-target="#modalLogin" data-bs-dismiss="modal">Inicia sesión</a>
                            </small>
                        </div>
                    </div>

                    <!-- PASO 2: DIAGNÓSTICO Y RESTRICCIONES -->
                    <div id="step2Container" style="display: none;">
                        <p class="text-secondary small mb-3" style="font-size: 0.8rem; line-height: 1.4;">
                            Indícanos tus objetivos y restricciones para adaptar tus rutinas de gimnasio y menús alimenticios.
                        </p>

                        <div class="mb-3">
                            <label class="auth-label">OBJETIVO PRINCIPAL</label>
                            <select id="diagGoal" class="form-select auth-input">
                                <option value="hipertrofia">Ganancia muscular (Hipertrofia)</option>
                                <option value="definicion">Pérdida de grasa / Definición</option>
                                <option value="fuerza">Fuerza funcional y resistencia</option>
                                <option value="rehabilitacion">Rehabilitación física / Movilidad</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="auth-label">RESTRICCIONES ALIMENTICIAS</label>
                            <select id="diagDiet" class="form-select auth-input">
                                <option value="ninguna">Ninguna</option>
                                <option value="lactosa">Intolerancia a la lactosa</option>
                                <option value="frutos_secos">Alergia a frutos secos / maní</option>
                                <option value="gluten">Celiaquía / Sin gluten</option>
                                <option value="vegetariano">Dieta Vegetariana / Vegana</option>
                                <option value="sodio">Bajo en sodio / Hipertensión</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="auth-label">CONDICIONES MÉDICAS O LESIONES (OPCIONAL)</label>
                            <textarea id="diagInjuries" class="form-control auth-input" rows="3" placeholder="Ej: Dolor en rodilla derecha al flexionar, molestia lumbar..."></textarea>
                        </div>

                        <div class="d-flex gap-2 mb-3">
                            <button type="button" id="btnBackToStep1" class="btn btn-outline-light text-uppercase fw-bold px-3" style="font-size: 0.85rem;">
                                &larr; VOLVER
                            </button>
                            <button type="submit" class="btn btn-brand w-100 fw-bold text-uppercase py-2" style="font-size: 0.85rem;">
                                FINALIZAR REGISTRO & PLAN
                            </button>
                        </div>
                    </div>

                </form>

            </div>
        </div>
    </div>

    <!-- Modal Login -->
    <div class="modal fade" id="modalLogin" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark text-white border-secondary">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title fw-bold text-uppercase brand-title text-brand">Iniciar Sesión</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- Formulario conectado al Backend en C# -->
                    <form asp-controller="Account" asp-action="Login" method="post">

                        @if (TempData["ErrorLogin"] != null)
                        {
                            <div class="alert alert-danger py-2 small" role="alert">
                                @TempData["ErrorLogin"]
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label small text-secondary">Correo</label>
                            <input type="email" name="correo" class="form-control bg-black text-white border-secondary" placeholder="correo@ejemplo.com" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small text-secondary">Contraseña</label>
                            <input type="password" name="contrasena" class="form-control bg-black text-white border-secondary" required>
                        </div>
                        <button type="submit" class="btn btn-brand w-100 fw-bold text-uppercase">Entrar</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
  

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Lógica de Interacción -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
          // 1. FitBot
          const fitbotBtn = document.getElementById('fitbotToggleBtn');
          const fitbotWindow = document.getElementById('fitbotWindow');
          const fitbotClose = document.getElementById('fitbotCloseBtn');
          const fitbotBody = document.getElementById('fitbotBody');

          if (fitbotBtn) {
            fitbotBtn.addEventListener('click', () => {
              fitbotWindow.classList.toggle('active');
              fitbotBtn.classList.remove('fitbot-pulse');
            });
          }

          if (fitbotClose) {
            fitbotClose.addEventListener('click', () => {
              fitbotWindow.classList.remove('active');
            });
          }

          window.handleFitbotQuestion = function (questionText, targetSectionId, botResponse) {
            const userMsg = document.createElement('div');
            userMsg.className = 'fitbot-msg user';
            userMsg.textContent = questionText;
            fitbotBody.appendChild(userMsg);
            fitbotBody.scrollTop = fitbotBody.scrollHeight;

            setTimeout(() => {
              const botMsg = document.createElement('div');
              botMsg.className = 'fitbot-msg bot';
              botMsg.innerHTML = `${botResponse} <br><small class="text-brand">⚡ Redirigiendo en 0.9s...</small>`;
              fitbotBody.appendChild(botMsg);
              fitbotBody.scrollTop = fitbotBody.scrollHeight;

              setTimeout(() => {
                const section = document.querySelector(targetSectionId);
                if (section) {
                  section.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
              }, 900);
            }, 350);
          };

          // 2. Wizard de Registro en 2 pasos
          const s1 = document.getElementById('step1Container');
          const s2 = document.getElementById('step2Container');
          const btnNext = document.getElementById('btnGoToStep2');
          const btnPrev = document.getElementById('btnBackToStep1');
          const title = document.getElementById('wizardTitle');
          const sub = document.getElementById('stepSub');
          const badge = document.getElementById('stepIndicator');
          const errBox = document.getElementById('step1Error');

          if (btnNext) {
            btnNext.addEventListener('click', function () {
              const name = document.getElementById('regName').value.trim();
              const email = document.getElementById('regEmail').value.trim();
              const phone = document.getElementById('regPhone').value.trim();
              const pass = document.getElementById('regPass').value;
              const passConf = document.getElementById('regPassConf').value;

              if (!name || !email || !phone || !pass) {
                errBox.textContent = 'Por favor completa todos los campos del registro.';
                errBox.classList.remove('d-none');
                return;
              }

              if (pass.length < 6) {
                errBox.textContent = 'La contraseña debe tener al menos 6 caracteres.';
                errBox.classList.remove('d-none');
                return;
              }

              if (pass !== passConf) {
                errBox.textContent = 'Las contraseñas no coinciden.';
                errBox.classList.remove('d-none');
                return;
              }

              errBox.classList.add('d-none');
              s1.style.display = 'none';
              s2.style.display = 'block';
              title.textContent = 'DIAGNÓSTICO';
              sub.textContent = '// PERSONALIZACIÓN';
              badge.textContent = 'PASO 2 / 2';
            });
          }

          if (btnPrev) {
            btnPrev.addEventListener('click', function () {
              s2.style.display = 'none';
              s1.style.display = 'block';
              title.textContent = 'REGISTRO';
              sub.textContent = '// CREAR CUENTA';
              badge.textContent = 'PASO 1 / 2';
            });
          }

          const form = document.getElementById('registerWizardForm');
          if (form) {
            form.addEventListener('submit', function (e) {
              e.preventDefault();
              const userName = document.getElementById('regName').value.trim();
              alert(`¡Bienvenido a FITBOOM, ${userName}! Tu cuenta ha sido creada y tu plan de entrenamiento y nutrición se ha personalizado.`);
              const modalEl = document.getElementById('modalOnboarding');
              const modalInstance = bootstrap.Modal.getInstance(modalEl);
              if (modalInstance) modalInstance.hide();
            });
          }
        });
    </script>
</body>
</html>
