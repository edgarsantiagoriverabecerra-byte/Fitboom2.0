@model IEnumerable<FITBOOM.Models.Usuario>

@{
    ViewData["Title"] = "Lista de Usuarios";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fitboom - Lista de Usuarios</title>
    <style>
        :root {
            --bg-dark: #0f1014;
            --bg-card: #16181d;
            --neon-green: #ccff00;
            --text-main: #ffffff;
            --text-muted: #9ca3af;
            --border-color: #2d3139;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        /* Navbar estilo Fitboom */
        header {
            background-color: var(--bg-dark);
            border-bottom: 1px solid var(--border-color);
            padding: 20px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 24px;
            font-weight: 900;
            color: var(--neon-green);
            letter-spacing: 1px;
            text-decoration: none;
        }

        nav ul {
            display: flex;
            list-style: none;
            gap: 24px;
        }

            nav ul li a {
                color: var(--text-main);
                text-decoration: none;
                font-size: 14px;
                font-weight: 600;
                transition: color 0.2s;
            }

                nav ul li a:hover {
                    color: var(--neon-green);
                }

        .nav-buttons {
            display: flex;
            align-items: center;
        }

        .btn-unete {
            background-color: var(--neon-green);
            border: none;
            color: #000;
            padding: 9px 18px;
            border-radius: 4px;
            font-weight: 700;
            font-size: 14px;
            cursor: pointer;
            text-decoration: none;
        }

        /* Contenido Principal */
        main {
            padding: 40px;
            max-width: 1200px;
            margin: 0 auto;
            width: 100%;
            flex: 1;
        }

        .header-section {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        h1 {
            font-size: 32px;
            font-weight: 700;
            color: var(--text-main);
        }

        .btn-nuevo {
            background-color: var(--neon-green);
            color: #000;
            padding: 10px 20px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: 700;
            font-size: 14px;
            transition: opacity 0.2s;
        }

            .btn-nuevo:hover {
                opacity: 0.9;
            }

        /* Tabla Estilizada */
        .table-container {
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            overflow: hidden;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }

        th {
            background-color: #1a1d24;
            color: var(--text-main);
            font-size: 14px;
            font-weight: 600;
            padding: 16px 20px;
            border-bottom: 1px solid var(--border-color);
        }

        td {
            padding: 16px 20px;
            font-size: 14px;
            color: var(--text-muted);
            border-bottom: 1px solid var(--border-color);
        }

        tr:last-child td {
            border-bottom: none;
        }

        tr:hover td {
            background-color: rgba(255, 255, 255, 0.01);
        }

        td:nth-child(2) {
            color: var(--text-main);
        }

        /* Botones de Acción */
        .actions {
            display: flex;
            gap: 8px;
        }

        .btn-accion {
            padding: 6px 12px;
            border-radius: 4px;
            font-size: 12px;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            border: 1px solid var(--neon-green);
            background: transparent;
            color: var(--neon-green);
            transition: all 0.2s ease;
        }

            .btn-accion:hover {
                background-color: var(--neon-green);
                color: #000;
            }

        .btn-eliminar {
            border-color: #ef4444;
            color: #ef4444;
        }

            .btn-eliminar:hover {
                background-color: #ef4444;
                color: #fff;
            }

        /* Footer */
        footer {
            border-top: 1px solid var(--border-color);
            padding: 20px 40px;
            text-align: left;
            font-size: 13px;
            color: var(--text-muted);
        }

            footer a {
                color: var(--neon-green);
                text-decoration: none;
            }
    </style>
</head>
<body>

    <!-- Contenido Principal -->
    <main>
        <div class="header-section">
            <h1>Lista de Usuarios</h1>
            <a asp-action="Create" class="btn fw-bold" style="background-color: #ADFF2F; color: #000;">
                + Nuevo Usuario
            </a>
        </div>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Nombre</th>
                        <th>Correo</th>
                        <th>Contraseña</th>
                        <th>Rol</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.IdUsuario</td>
                                <td>@item.Nombre</td>
                                <td>@item.Correo</td>
                                <td>********</td>
                                <td>@item.Rol</td>
                                <td>
                                    <div class="actions">
                                        <a asp-action="Edit" asp-route-id="@item.IdUsuario" class="btn-accion">Editar</a>
                                        <a asp-action="Details" asp-route-id="@item.IdUsuario" class="btn-accion">Detalles</a>
                                        <a asp-action="Delete" asp-route-id="@item.IdUsuario" class="btn-accion btn-eliminar">Eliminar</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" style="text-align: center;">No hay usuarios registrados en la base de datos.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </main>

    <!-- Footer -->
    <footer>
        &copy; 2026 - Fitboom2._0 - <a href="#">Privacy</a>
    </footer>

</body>
</html>