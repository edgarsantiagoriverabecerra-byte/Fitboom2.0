@model FITBOOM.Models.Usuario

@{
    ViewData["Title"] = "Eliminar Usuario";
}

<div class="container mt-4" style="color: white; max-width: 600px;">
    <h2 class="mb-2" style="color: #ff4d4d; font-weight: bold;">Eliminar Usuario</h2>
    <h5 class="mb-4 text-muted">¿Estás seguro de que deseas eliminar este usuario de forma permanente?</h5>

    <div style="background-color: #1a1a1a; padding: 30px; border-radius: 8px; border: 1px solid #333;">
        <dl class="row">
            <dt class="col-sm-4 text-muted">Nombre:</dt>
            <dd class="col-sm-8 fw-bold" style="font-size: 16px;">@Model.Nombre</dd>

            <dt class="col-sm-4 text-muted">Correo:</dt>
            <dd class="col-sm-8">@Model.Correo</dd>

            <dt class="col-sm-4 text-muted">Rol:</dt>
            <dd class="col-sm-8">
                <span class="badge" style="background-color: #ADFF2F; color: #000; font-weight: bold; padding: 5px 10px;">
                    @Model.Rol
                </span>
            </dd>
        </dl>

        <form asp-action="Delete" method="post" class="mt-4 d-flex justify-content-between align-items-center">
            <!-- Cambia "ID" por el nombre exacto de la llave primaria en tu modelo si es diferente (ej. IdUsuario) -->
            <input type="hidden" asp-for="IdUsuario" />

            <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
            <button type="submit" class="btn btn-danger fw-bold px-4" style="background-color: #dc3545; border: none;">Sí, Eliminar</button>
        </form>
    </div>
</div>